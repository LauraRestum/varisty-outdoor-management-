# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend (email)
RESEND_API_KEY=your_resend_api_key

# Google Sheet web app (see scripts/google-forms/quote-form.gs)
# Website quote requests are logged in the same sheet as the Google Form
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SHEET_WEBHOOK_SECRET=copy_from_the_sheet_setup_tab

# Owner notification email
OWNER_EMAIL=bergkampw@gmail.com

# App URL (used in email templates)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Weather API (OpenWeatherMap - free tier)
OPENWEATHER_API_KEY=your_openweather_api_key
NEXT_PUBLIC_BUSINESS_CITY=your_city_name
